<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Go Together" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
<% if admin_signed_in? %>
  <p>Welcome, <%= current_admin.email %></p>
  <%= link_to "Logout", destroy_admin_session_path, method: :delete %>
<% else %>
  <%= link_to "Admin Login", new_admin_session_path %> |
  <%= link_to "Sign Up", new_admin_registration_path %> |
  <%= link_to "Forgot Password?", new_admin_password_path %>
<% end %>
  
